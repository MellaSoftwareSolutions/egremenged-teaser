# ==============================================================================
# Egre Menged (እግረ መንገድ) - Environment Variables
# ==============================================================================

# Target Google Spreadsheet ID (from spreadsheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID="your_google_spreadsheet_id_here"

# Google Service Account Email (from Google Cloud Console > IAM & Admin > Service Accounts)
GOOGLE_CLIENT_EMAIL="egremenged-waitlist@your-project-id.iam.gserviceaccount.com"

# Google Service Account Private Key (paste raw private_key directly from service-account JSON)
# Vercel and local parsing safely handles quotes and escaped newlines (\n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional: Target Sheet tab name (defaults to "Waitlist"; auto-created/renamed if missing)
GOOGLE_SHEET_TAB_NAME="Waitlist"

# Optional: Canonical site URL for OpenGraph and social previews (defaults to https://egremenged.vercel.app)
NEXT_PUBLIC_SITE_URL="https://egremenged.vercel.app"
